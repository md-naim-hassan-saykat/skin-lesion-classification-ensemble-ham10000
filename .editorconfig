# .editorconfig

root = true

[*]
indent_style = space
indent_size = 4
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

# Markdown files — preserve intentional trailing spaces (for line breaks)
[*.md]
trim_trailing_whitespace = false

# YAML / JSON / TOML configs — 2 spaces for readability
[*.{yml,yaml,json,toml}]
indent_size = 2

# Shell scripts — 4 spaces, LF endings
[*.sh]
indent_style = space
indent_size = 4
end_of_line = lf

# Python files — standard 4 spaces, no tabs
[*.py]
indent_style = space
indent_size = 4

# Ignore notebooks and binary files
[*.ipynb]
insert_final_newline = false
trim_trailing_whitespace = false
