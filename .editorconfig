# ==============================================================
# .editorconfig
# Consistent formatting rules for the HAM10000 / ISIC 2019
# skin-lesion classification and reproducibility repository
# ==============================================================

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4
trim_trailing_whitespace = true

[*.py]
indent_style = space
indent_size = 4

[*.md]
trim_trailing_whitespace = false

[*.{yml,yaml,json,toml}]
indent_style = space
indent_size = 2

[*.ipynb]
insert_final_newline = false
trim_trailing_whitespace = false

[*.sh]
indent_style = space
indent_size = 4
end_of_line = lf

[{Makefile,makefile}]
indent_style = tab

[*.{txt,cfg,ini}]
indent_style = space
indent_size = 4
