# ==============================================================
# .editorconfig
# Enforces consistent code style across editors and contributors
# Project: Skin Lesion Ensemble (HAM10000 & ISIC 2019)
# ==============================================================

root = true

# === Default Settings ===
[*]
indent_style = space
indent_size = 4
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

# === Markdown Files ===
# Preserve intentional trailing spaces (used for manual line breaks)
[*.md]
trim_trailing_whitespace = false

# === YAML / JSON / TOML Configs ===
# Use 2 spaces for readability and alignment
[*.{yml,yaml,json,toml}]
indent_size = 2

# === Shell Scripts ===
# Enforce 4-space indentation and LF endings
[*.sh]
indent_style = space
indent_size = 4
end_of_line = lf

# === Python Files ===
# Standard Python convention — 4 spaces, never tabs
[*.py]
indent_style = space
indent_size = 4

# === Notebooks and Binary Files ===
# Disable newline/trimming — handled by Jupyter
[*.ipynb]
insert_final_newline = false
trim_trailing_whitespace = false
