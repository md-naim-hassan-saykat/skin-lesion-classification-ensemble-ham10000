# =============================================================================
# .gitattributes
# Skin Lesion Classification Ensemble — HAM10000 & ISIC 2019
#
# Normalize text files to LF for reproducible cross-platform development.
# Git LFS is reserved for large model and numerical binary artifacts that are
# intentionally committed. Curated manuscript figures remain in regular Git.
# =============================================================================

# -----------------------------------------------------------------------------
# Default text normalization
# -----------------------------------------------------------------------------
* text=auto eol=lf

# -----------------------------------------------------------------------------
# Large model and checkpoint artifacts — Git LFS
# -----------------------------------------------------------------------------
*.pth    filter=lfs diff=lfs merge=lfs -text
*.pt     filter=lfs diff=lfs merge=lfs -text
*.ckpt   filter=lfs diff=lfs merge=lfs -text
*.onnx   filter=lfs diff=lfs merge=lfs -text
*.h5     filter=lfs diff=lfs merge=lfs -text

# -----------------------------------------------------------------------------
# Numerical binary arrays — Git LFS
# -----------------------------------------------------------------------------
*.npy    filter=lfs diff=lfs merge=lfs -text
*.npz    filter=lfs diff=lfs merge=lfs -text

# -----------------------------------------------------------------------------
# Source, configuration, metadata, documentation, and result tables
# -----------------------------------------------------------------------------
*.py     text eol=lf
*.sh     text eol=lf
*.yml    text eol=lf
*.yaml   text eol=lf
*.json   text eol=lf
*.csv    text eol=lf
*.tsv    text eol=lf
*.md     text eol=lf
*.txt    text eol=lf
*.svg    text eol=lf
*.tex    text eol=lf
*.toml   text eol=lf
*.ini    text eol=lf
*.cff    text eol=lf

# -----------------------------------------------------------------------------
# Jupyter notebooks
# -----------------------------------------------------------------------------
*.ipynb  text eol=lf

# -----------------------------------------------------------------------------
# Binary images and documents — regular Git
# -----------------------------------------------------------------------------
*.png    binary
*.jpg    binary
*.jpeg   binary
*.gif    binary
*.webp   binary
*.tif    binary
*.tiff   binary
*.pdf    binary

# -----------------------------------------------------------------------------
# Binary archives
# -----------------------------------------------------------------------------
*.zip    binary
*.tar    binary
*.gz     binary
