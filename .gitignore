# ==============================================================
# General .gitignore for Deep Learning Projects
# Project: Skin Lesion Ensemble (HAM10000 & ISIC 2019)
# ==============================================================

# === Data & Outputs ===
data/
datasets/
outputs/
results/
logs/
checkpoints/

# === Python Build / Cache ===
__pycache__/
*.egg-info/
*.pyc
*.pyd
*.pyo
build/
dist/

# === Virtual Environments ===
.venv/
env/
venv/

# === Large or Accidental Artifacts ===
*.ckpt
*.csv
*.h5
*.npz
*.npy
*.onnx
*.pth
*.pt
*.tar
*.tar.gz
*.xlsx
*.zip

# === Image and Visualization Artifacts ===
*.jpeg
*.jpg
*.pdf
*.png

# === Jupyter Notebook Checkpoints ===
.ipynb_checkpoints/

# === IDE / Editor Settings ===
.idea/
.vscode/
*.swo
*.swp

# === OS-Specific Files ===
.DS_Store
Thumbs.db

# === Temporary or Backup Files ===
*.bak
*.tmp

# === Local Project Copies or Test Folders ===
skin-lesion-classification-ensemble-ham10000/
