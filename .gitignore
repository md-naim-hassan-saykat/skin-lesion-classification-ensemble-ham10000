# General .gitignore for Deep Learning Projects

# === Data & Outputs ===
data/
datasets/
outputs/
results/
logs/
checkpoints/

# === Python Build / Cache ===
__pycache__/
*.pyc
*.pyo
*.pyd
*.egg-info/
build/
dist/

# === Virtual Environments ===
.venv/
env/
venv/

# === Large or Accidental Artifacts ===
*.pth
*.pt
*.ckpt
*.onnx
*.csv
*.xlsx
*.npy
*.npz
*.zip
*.tar
*.tar.gz
*.h5

# === Image and Visualization Artifacts ===
*.png
*.jpg
*.jpeg
*.pdf

# === Jupyter Notebook Checkpoints ===
.ipynb_checkpoints/

# === IDE / Editor Settings ===
.vscode/
.idea/
*.swp
*.swo

# === OS-Specific Files ===
.DS_Store
Thumbs.db

# === Temporary or Backup Files ===
*.bak
*.tmp

# === Local Project Copies or Test Folders ===
skin-lesion-classification-ensemble-ham10000/
